GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_QUOTA_PROJECT=your-gcp-project-id
# Parallel API key lives in GCP Secret Manager (secret: parallel-api-key).
# For local dev, paste it here; never commit .env.
PARALLEL_API_KEY=pk_replace_me
# local = in-process ADK agents; engine = deployed Agent Engine endpoints
CLEARSLATE_AGENT_RUNTIME=local
CLEARSLATE_BREAKDOWN_MODEL=gemini-3.6-flash
# gemini-3.6-flash is only served on Vertex AI's "global" endpoint; regional
# endpoints like us-central1 404 on it. Independent of GOOGLE_CLOUD_LOCATION above
# (which is the Agent Engine deployment region, not the Gemini inference region).
CLEARSLATE_BREAKDOWN_MODEL_LOCATION=global
# Set after `adk deploy agent_engine` of the breakdown agent
CLEARSLATE_BREAKDOWN_ENGINE_ID=
