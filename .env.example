GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_QUOTA_PROJECT=your-gcp-project-id
# Parallel API key lives in GCP Secret Manager (secret: parallel-api-key).
# For local dev, paste it here; never commit .env.
PARALLEL_API_KEY=pk_replace_me
# local = in-process ADK agents; engine = deployed Agent Engine endpoints
CLEARSLATE_AGENT_RUNTIME=local
CLEARSLATE_BREAKDOWN_MODEL=gemini-2.5-flash
# Set after `adk deploy agent_engine` of the breakdown agent
CLEARSLATE_BREAKDOWN_ENGINE_ID=
